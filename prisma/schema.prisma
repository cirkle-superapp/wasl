// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  about     String   @default("Hey there! I am using Wasl.")
  avatar    String?
  avatarColor String?
  online    Boolean  @default(false)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentMessages      Message[]      @relation("MessageSender")
  conversations     Participant[]
  createdConversations Conversation[] @relation("ConversationCreator")
  createdCommits    Commit[]      @relation("CommitCreator")
  countersignedCommits Commit[]   @relation("CommitCounterparty")
}

model Conversation {
  id        String   @id @default(cuid())
  name      String?
  isGroup   Boolean  @default(false)
  avatar    String?
  avatarColor String?
  createdBy String?
  creator   User?   @relation("ConversationCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants Participant[]
  messages     Message[]
  commits      Commit[]
  polls        Poll[]
}

model Participant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           String   @default("text") // text, image, system, commit
  status         String   @default("sent") // sent, delivered, read
  replyToId      String?
  commitId       String?  // link to a Commit when type === 'commit'
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions    Reaction[]
  starredBy    StarredMessage[]

  @@index([conversationId, createdAt])
}

/// Cirkle-inspired Commit (AI-verified agreement) anchored to a conversation.
/// Simplified subset for Wasl: type, parties (creator + counterparty),
/// amount + currency, deadline, conditions, fairness score, hash, and a
/// two-party signature state machine (pending -> active -> completed|disputed).
model Commit {
  id              String   @id @default(cuid())
  conversationId  String
  creatorId       String
  counterpartyId  String
  type            String   @default("price") // price|work|service|rental|group_buy
  title           String
  description     String   @default("")
  amount          Float   @default(0)
  currency        String   @default("SAR")
  deadline        String?
  conditions      String   @default("[]") // JSON-encoded string[]
  status          String   @default("pending") // pending|active|completed|disputed
  fairnessScore   Int      @default(0) // 0-100
  fairnessNote    String   @default("")
  hash            String
  creatorSigned   Boolean  @default(true)
  counterpartySigned Boolean @default(false)
  creatorSignedAt  DateTime?
  counterpartySignedAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creator      User         @relation("CommitCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty User         @relation("CommitCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([counterpartyId])
}

/// Emoji reaction on a message. One per user per message (toggling).
model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

/// Personally starred (pinned) message for a user.
model StarredMessage {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// Chat poll — Cirkle-inspired chat-poll feature. A poll is posted as a
/// special message (type='poll'); members vote on options.
model Poll {
  id             String   @id @default(cuid())
  conversationId String
  question       String
  options        String   @default("[]") // JSON-encoded [{id,text}]
  multiChoice    Boolean  @default(false)
  anonymous      Boolean  @default(false)
  createdBy      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  votes        PollVote[]

  @@index([conversationId, createdAt])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
}

/// Status / Story — ephemeral 24h image/text status shown in a story bar
/// above the chat list. Cirkle-inspired story-status feature.
model Story {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("text") // text | image
  content   String   // text content OR image data URL
  bgColor   String?  // background color for text stories
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, createdAt])
}

/// Story view — tracks which user has seen which story.
model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
}

/// Chat folder — user-defined folders to organize conversations.
/// Cirkle-inspired chat-folders feature.
model ChatFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  icon      String?
  createdAt DateTime @default(now())

  conversations FolderConversation[]

  @@unique([userId, name])
}

/// Folder-conversation membership.
model FolderConversation {
  id             String   @id @default(cuid())
  folderId       String
  conversationId String
  addedAt        DateTime @default(now())

  folder       ChatFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, conversationId])
  @@index([folderId])
}
