// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  // Cirkle username — unique, chosen by the user with live availability check.
  username  String   @unique
  password  String
  name      String
  // Email (Cirkle email) — used as an alternate login identifier.
  email     String?  @unique
  // The "active" phone number — used as the display number for this account.
  // A user can have multiple phone numbers and switch between them.
  phone     String?
  about     String   @default("Hey there! I am using Wasl.")
  avatar    String?
  avatarColor String?
  online    Boolean  @default(false)
  // Person verification — a user must be verified before they can register a
  // business. Stores the path to the uploaded ID document.
  verified       Boolean  @default(false)
  idDocPath      String?
  verifiedAt     DateTime?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- Privacy / message protection ------------------------------------------
  // When true, all outgoing messages from this user are protected from
  // screenshot and forwarding by default (per-message `protected` can override).
  defaultProtectMessages Boolean @default(false)
  // When true, this user can always screenshot/forward any message they
  // receive, regardless of whether the sender protected it. The user has
  // chosen "privacy always allow" — opting out of receiving protection.
  privacyAlwaysAllow     Boolean @default(false)
  // Ghost Mode — when true, hides the user's online status, last seen,
  // and typing indicator from all other users.
  ghostMode             Boolean @default(false)
  // When true, hides the user's "last seen" timestamp from others.
  hideLastSeen           Boolean @default(false)

  sentMessages      Message[]      @relation("MessageSender")
  conversations     Participant[]
  createdConversations Conversation[] @relation("ConversationCreator")
  createdCommits    Commit[]      @relation("CommitCreator")
  countersignedCommits Commit[]   @relation("CommitCounterparty")
  stories          Story[]
  folders          ChatFolder[]
  phoneNumbers     PhoneNumber[]
  screenshotAttempts ScreenshotAttempt[] @relation("ScreenshotReporter")
  // Messages this user has "deleted for me" (locally hidden, still visible to
  // other participants). See the `DeletedForMe` model.
  deletedForMe     DeletedForMe[]
  // Business
  ownedBusinesses   Business[]     @relation("BusinessOwner")
  businessMemberships BusinessMember[]
  ownedServiceProviders ServiceProvider[] @relation("ServiceProviderOwner")
  // Contacts (address book) — users this person has saved as a contact
  contacts          Contact[]      @relation("ContactOwner")
  // When this user appears in someone else's address book
  contactOf         Contact[]      @relation("ContactTarget")
  // Messages this user has bookmarked for follow-up (Save for later).
  bookmarks         Bookmark[]
  // Unsent message drafts saved per-conversation (one per user+conversation).
  drafts            Draft[]

  // ---- School Connect (My School) --------------------------------------------
  // Schools this user registered (they are the institution owner/admin).
  ownedSchools        School[]               @relation("SchoolOwner")
  // When the user IS a student at a school (linked via School Connect).
  studentRecords      SchoolStudent[]        @relation("SchoolStudentUser")
  // Schools the user is a member of (admin/teacher/staff/student/parent role).
  schoolMemberships   SchoolMembership[]     @relation("SchoolMember")
  // Connections this user has as a PARENT to one or more students.
  parentConnections   SchoolParentConnection[] @relation("SchoolParent")

  // ---- Block / mute other users ---------------------------------------------
  // Users this user has blocked. Blocked users can't send messages to this
  // user, can't see their online/last-seen/stories, and can't add them to
  // new group conversations.
  blocking            Block[]               @relation("Blocker")
  // Users who have blocked THIS user (reverse direction for fast lookups
  // when deciding whether to show "You are blocked" indicators).
  blockedBy           Block[]               @relation("Blocked")

  // ---- API tokens (Task 89) ------------------------------------------------
  // Personal access tokens this user has issued to integrate Wasl with
  // external platforms (CRM, school admin, business automation, etc.).
  // Each token carries a scoped set of permissions and is hashed at rest
  // (we never store the raw token after creation).
  apiTokens           ApiToken[]
  // Audit log of every API call made with one of this user's tokens — used
  // for security forensics + suspicious-activity detection.
  auditLogs           AuditLog[]
  // Multi-message multi-recipient scheduled batches (Task 89). Each batch
  // can fan out N messages × M recipients (specific convs / scope categories).
  scheduledBatches    ScheduledBatch[]

  // ---- Wasl Vault (Task 90) ------------------------------------------------
  // Zero-knowledge encrypted personal vault. Stores passwords, recovery
  // codes, ID numbers, secure notes — all encrypted client-side with a
  // master password via Web Crypto API (PBKDF2 + AES-GCM). The server
  // never sees the plaintext or the derived key.
  vaultEntries        VaultEntry[]
  // Per-user vault master key salt (set once, when the vault is first
  // initialized). Used to derive the AES key from the master password.
  vaultSalt           String?
  // Per-user vault verifier — an encrypted known-plaintext that lets us
  // verify the master password is correct before trying to decrypt entries.
  vaultVerifier       String?

  // ---- Hash-chain message integrity (Task 90) -----------------------------
  // Each user has their own hash chain that records every message they send
  // or receive. Each entry's chainHash = SHA-256(prevHash + message data).
  // The chain is tamper-evident — modifying a message's content invalidates
  // every subsequent hash in the chain.
  chainEntries        MessageChainEntry[]

  // ---- Multi-device sync (Task 93) --------------------------------------
  // Every browser/tab/app instance the user is signed in on registers a
  // DeviceSession. This powers the "Devices" dialog (sign out everywhere),
  // the "new device signed in" toast, and real-time multi-device sync
  // (when a message is sent on phone, it appears on web — and vice versa).
  deviceSessions      DeviceSession[]
}

/// Contact (address book entry) — a saved contact. `ownerId` is the user who
/// saved the contact, `userId` is the contacted user (nullable for contacts
/// not yet on Wasl). `nickname` is an optional custom display name.
model Contact {
  id          String   @id @default(cuid())
  ownerId     String
  userId      String?
  // Display name as saved by the owner (may differ from the user's actual name)
  nickname    String?
  // Phone number (for contacts not yet on Wasl, or to remember which number)
  phone       String?
  // Optional notes about this contact (only visible to the owner)
  notes       String?
  // When the contact was added
  addedAt     DateTime @default(now())

  owner User  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user  User? @relation("ContactTarget", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([ownerId, userId])
  @@index([ownerId])
  @@index([userId])
}

/// A phone number attached to a user account. A user can have multiple numbers
/// and switch the "active" one at any time. Only the active number is visible
/// to other users and used for outgoing messages.
model PhoneNumber {
  id        String   @id @default(cuid())
  userId    String
  number    String
  label     String?  // e.g. "Personal", "Work", "Business"
  // Portal display name shown beside the user's username when this number is
  // the active portal. E.g. portalName="Work" → messages show
  // "@username · Real Name (Work)". Null = no portal label, just the
  // authenticated name.
  portalName String?
  // When true, this number is hidden from other users — they see the
  // username + portal name but not the actual phone digits. The user can
  // still receive calls/messages on this number; only the visibility is
  // affected.
  hideNumber Boolean @default(false)
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, number])
  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  name      String?
  isGroup   Boolean  @default(false)
  avatar    String?
  avatarColor String?
  // Optional group description (like WhatsApp group "about"). Only set by admins.
  description String?
  createdBy String?
  creator   User?   @relation("ConversationCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Invite token for group join-via-link. When null, no invite link exists.
  // Generate a new token to (re)generate the link, or set to null to revoke.
  inviteToken      String?
  inviteTokenSetAt DateTime?

  participants Participant[]
  messages     Message[]
  commits      Commit[]
  polls        Poll[]
  // Unsent message drafts saved per-user for this conversation.
  drafts       Draft[]
}

model Participant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())
  // When true, desktop notifications and unread badge increments are
  // suppressed for this conversation (per-user mute setting).
  muted          Boolean  @default(false)
  // When true, the conversation is archived (hidden from the main list).
  // Can be unarchived by searching or visiting the Archived tab.
  archived        Boolean  @default(false)
  // Role within the group: 'admin' can add/remove members, change group name,
  // and pin messages. 'member' is the default. Group creators are auto-admin.
  role            String   @default("member")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           String   @default("text") // text, image, system, commit, voice, poll
  status         String   @default("sent") // sent, delivered, read
  replyToId      String?
  commitId       String?  // link to a Commit when type === 'commit'
  // When sending "as a business", this overrides the sender display name + avatar
  // color in the chat. The senderId stays the real user; this just controls how
  // the message appears to others.
  senderLabel    String?
  senderLabelColor String?
  senderAvatarPath String?
  // Which phone number was active when this message was sent (optional, for
  // display purposes).
  fromPhone      String?
  // ---- Privacy / message protection ------------------------------------------
  // `null`  → use the sender's `defaultProtectMessages` setting.
  // `true`  → this message IS protected (recipient cannot screenshot or forward).
  // `false` → this message is NOT protected (anyone can screenshot or forward).
  protected      Boolean?
  // When true, the message has been edited at least once. The previous
  // versions are stored in the MessageEdit table.
  edited         Boolean  @default(false)
  // When true, the message is pinned to the top of the conversation by the
  // sender. Only one message per conversation can be pinned at a time.
  pinned         Boolean  @default(false)
  // Optional AI-generated transcription for voice messages. Populated by
  // POST /api/ai/transcribe when the user requests transcription of a voice
  // note. Null for non-voice messages or voice messages that haven't been
  // transcribed yet.
  transcription  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions    Reaction[]
  starredBy    StarredMessage[]
  // Users who have bookmarked (saved for later) this message.
  bookmarkedBy Bookmark[]
  screenshotAttempts ScreenshotAttempt[]
  edits        MessageEdit[]
  // Per-user "deleted for me" records — hides a message from a specific user's
  // view without affecting other participants.
  deletedForMe DeletedForMe[]

  @@index([conversationId, createdAt])
}

/// Tracks which messages a user has "deleted for me" — hides the message
/// only for that user while leaving it visible to other participants.
model DeletedForMe {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  deletedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// Message edit history — stores each previous version of a message's
/// content when the sender edits it. This enables the "edited" indicator
/// and the "view edit history" feature.
model MessageEdit {
  id        String   @id @default(cuid())
  messageId String
  content   String   // the previous content before the edit
  editedAt  DateTime @default(now()) // when this edit was made (i.e. when the new version replaced this one)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt])
}

/// Cirkle-inspired Commit (AI-verified agreement) anchored to a conversation.
/// Simplified subset for Wasl: type, parties (creator + counterparty),
/// amount + currency, deadline, conditions, fairness score, hash, and a
/// two-party signature state machine (pending -> active -> completed|disputed).
model Commit {
  id              String   @id @default(cuid())
  conversationId  String
  creatorId       String
  counterpartyId  String
  type            String   @default("price") // price|work|service|rental|group_buy
  title           String
  description     String   @default("")
  amount          Float   @default(0)
  currency        String   @default("SAR")
  deadline        String?
  conditions      String   @default("[]") // JSON-encoded string[]
  status          String   @default("pending") // pending|active|completed|disputed
  fairnessScore   Int      @default(0) // 0-100
  fairnessNote    String   @default("")
  hash            String
  creatorSigned   Boolean  @default(true)
  counterpartySigned Boolean @default(false)
  creatorSignedAt  DateTime?
  counterpartySignedAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creator      User         @relation("CommitCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  counterparty User         @relation("CommitCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([counterpartyId])
}

/// Emoji reaction on a message. One per user per message (toggling).
model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

/// Personally starred (pinned) message for a user.
model StarredMessage {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// Saved message (bookmark) — a personal reminder to follow up on a message.
/// Unlike starred messages, bookmarks have a "done" state and optional notes.
model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  messageId   String
  // Optional personal note about why this was bookmarked
  note        String?
  // When true, the bookmark is marked as "done" (followed up)
  done        Boolean  @default(false)
  doneAt      DateTime?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
}

/// Message draft — unsent text saved per-user per-conversation. Automatically
/// created/updated as the user types, and deleted when the message is sent.
model Draft {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  content        String
  // Optional: the reply target if the draft is a reply
  replyToId      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
}

/// Forwarding consent request — when a user tries to forward someone else's
/// message, the original sender must approve. The request contains the
/// message ID, requester ID, target conversation ID, and approval state.
/// Status: pending → approved | denied
model ForwardRequest {
  id              String   @id @default(cuid())
  messageId       String
  requesterId     String   // who wants to forward
  targetConversationId String // where they want to forward to
  status          String   @default("pending") // pending | approved | denied
  createdAt       DateTime @default(now())
  respondedAt     DateTime?

  @@index([requesterId])
  @@index([messageId])
}

/// Chat poll — Cirkle-inspired chat-poll feature. A poll is posted as a
/// special message (type='poll'); members vote on options.
model Poll {
  id             String   @id @default(cuid())
  conversationId String
  question       String
  options        String   @default("[]") // JSON-encoded [{id,text}]
  multiChoice    Boolean  @default(false)
  anonymous      Boolean  @default(false)
  createdBy      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  votes        PollVote[]

  @@index([conversationId, createdAt])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
}

/// Status / Story — ephemeral 24h image/text status shown in a story bar
/// above the chat list. Cirkle-inspired story-status feature.
model Story {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("text") // text | image
  content   String   // text content OR image data URL
  bgColor   String?  // background color for text stories
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Story view — tracks which user has seen which story.
model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
}

/// Chat folder — user-defined folders to organize conversations.
/// Cirkle-inspired chat-folders feature.
model ChatFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  icon      String?
  createdAt DateTime @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations FolderConversation[]

  @@unique([userId, name])
}

/// Folder-conversation membership.
model FolderConversation {
  id             String   @id @default(cuid())
  folderId       String
  conversationId String
  addedAt        DateTime @default(now())

  folder       ChatFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, conversationId])
  @@index([folderId])
}

// ==========================================================================
// Business accounts — Cirkle-inspired business feature.
// A verified person can register a business. The business must be verified
// (upload company registration + tax number + ID of someone on the
// registration). Once verified, the owner can create public/private groups
// and invite members. A business can have a hidden phone number that only
// surfaces via the business search.
// ==========================================================================

model Business {
  id              String   @id @default(cuid())
  name            String
  ownerId         String
  // Public search handle (unique). Users find the business by this name.
  description     String   @default("")
  avatarPath      String?
  avatarColor     String?
  category        String?  // e.g. "Technology", "Food", "Customer Service"
  // Verification
  registrationDocPath String?  // company registration document
  taxDocPath          String?  // tax number document
  idDocPath           String?  // ID of someone on the registration
  status          String   @default("pending") // pending | approved | rejected
  rejectionReason String?
  verifiedAt      DateTime?
  // A hidden phone number that only surfaces via business search.
  hiddenPhone     String?
  hidePhone       Boolean  @default(false)
  verified        Boolean  @default(false)
  // ---- Privacy / message protection (business accounts) ---------------------
  // Same semantics as User.defaultProtectMessages: when true, every message
  // sent "as this business" is protected from screenshot/forwarding unless the
  // individual message overrides it with `protected: false`.
  defaultProtectMessages Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner   User              @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members BusinessMember[]
  groups  BusinessGroup[]

  @@index([ownerId])
}

/// Membership in a business. The owner is an admin by default; the owner can
/// promote other members to admin. Only admins/owner can invite people.
model BusinessMember {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  role        String   @default("member") // member | admin
  invitedBy   String?
  joinedAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
}

/// A group owned by a business. Can be public (anyone can find + join via
/// business search) or private (invite-only, doesn't appear in search).
/// Maps to a Conversation with `isGroup=true`; we link via conversationId.
model BusinessGroup {
  id             String   @id @default(cuid())
  businessId     String
  conversationId String
  name           String
  description    String   @default("")
  visibility     String   @default("private") // public | private
  category       String?  // e.g. "Customer Service", "Orders", "Employees"
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([visibility])
}

// ==========================================================================
// Official Service Providers — banks, government ministries, utilities.
// These are manually authenticated and approved by Wasl admin staff.
// Once approved, they can broadcast official announcements to all users
// within a specific country.
//
// Registration flow:
//   1. User applies → uploads official registration documents + passes
//      liveness test (selfie video) + ID document
//   2. Wasl admin manually reviews → approves or rejects
//   3. Once approved, the provider gets a verified badge + broadcast rights
//
// Broadcast flow:
//   1. Provider creates an announcement (text/image)
//   2. System delivers to ALL users whose phone country code matches
//   3. Users see official announcements in a dedicated "Official" tab
// ==========================================================================

model ServiceProvider {
  id                String   @id @default(cuid())
  name              String   // e.g. "Ministry of Health", "National Bank of Egypt"
  ownerId           String   // the user who registered the provider
  type              String   @default("government") // government | bank | utility | telecom | healthcare
  description       String   @default("")
  avatarPath        String?
  avatarColor       String?
  // Official registration details
  officialName      String?  // legal entity name
  registrationNumber String? // government registration number
  taxNumber         String?
  // Country code for broadcast targeting (e.g. "+20" for Egypt)
  // All users whose phone starts with this code receive broadcasts
  countryCode       String   @default("+20")
  // Verification documents
  registrationDocPath String?  // official registration document
  idDocPath           String?  // ID of the authorized representative
  livenessVideoPath  String?  // selfie video for liveness check
  livenessVerified   Boolean  @default(false)
  // Approval state — manually reviewed by Wasl admin
  status            String   @default("pending") // pending | approved | rejected
  rejectionReason   String?
  verified          Boolean  @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?  // admin user ID who approved
  // Broadcast settings
  canBroadcast      Boolean  @default(false)  // can send announcements
  // Contact info
  contactPhone      String?
  contactEmail      String?
  website           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner     User                  @relation("ServiceProviderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  broadcasts ServiceProviderMessage[]

  @@index([ownerId])
  @@index([countryCode])
  @@index([status])
  @@index([type])
}

/// Official announcement from a verified service provider.
/// Delivered to all users within the provider's country code.
model ServiceProviderMessage {
  id              String   @id @default(cuid())
  providerId      String
  // The announcement content
  title           String
  content         String
  type            String   @default("announcement") // announcement | alert | notice | update
  // Optional image attachment (data URL or path)
  imagePath       String?
  // Targeting
  countryCode     String   // which country code this was sent to
  // Delivery status
  status          String   @default("sent") // sent | delivered
  // Priority — higher priority shows at top
  priority        Int      @default(0)
  // Allows the provider to mark as "dismissed by users" (future feature)
  createdAt       DateTime @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([countryCode])
}

/// Tracks which users have seen which official announcement.
/// Used for read receipts on broadcasts.
model ServiceProviderMessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

/// Tracks which users have dismissed (closed) an official announcement.
model ServiceProviderMessageDismissed {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  dismissedAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

/// Scheduled message — send at a future time (Cirkle-inspired scheduled-messages)
/// Supports recurring schedules: `repeat` can be 'none' (one-time), 'daily',
/// 'weekly', or 'monthly'. When a recurring message is sent, `scheduledFor`
/// is advanced to the next occurrence and `sent`/`sentAt` are reset so the
/// background scheduler picks it up again at the next time.
model ScheduledMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           String   @default("text")
  scheduledFor   DateTime
  sent           Boolean  @default(false)
  sentAt         DateTime?
  // Recurring schedule: 'none' = one-time, 'daily', 'weekly', 'monthly'.
  // When non-'none', the scheduler advances `scheduledFor` to the next
  // occurrence after sending instead of marking `sent=true`.
  repeat         String   @default("none")
  // Optional end date for recurring messages. After this date, the schedule
  // stops (message is marked sent=true so the scheduler skips it).
  repeatUntil    DateTime?
  createdAt      DateTime @default(now())

  @@index([scheduledFor])
  @@index([conversationId])
  @@index([senderId])
}

/// Broadcast channel — one-to-many messaging (Cirkle-inspired broadcast-channel)
model BroadcastChannel {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  ownerId     String
  avatarColor String?
  subscriberCount Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscribers BroadcastSubscriber[]
  messages    BroadcastMessage[]

  @@index([ownerId])
}

model BroadcastSubscriber {
  id          String   @id @default(cuid())
  channelId   String
  userId      String
  subscribedAt DateTime @default(now())

  channel BroadcastChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model BroadcastMessage {
  id          String   @id @default(cuid())
  channelId   String
  senderId    String
  content     String
  type        String   @default("text")
  createdAt   DateTime @default(now())

  channel BroadcastChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

/// Time capsule message — unlock at a future date (Cirkle-inspired time-capsule)
model TimeCapsule {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  unlockAt       DateTime
  opened         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([unlockAt])
  @@index([conversationId])
}

/// App lock PIN — per-user PIN for app access (Cirkle-inspired app-lock)
model AppLock {
  id        String   @id @default(cuid())
  userId    String   @unique
  pinHash   String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Threaded reply — a reply thread within a chat (Cirkle-inspired reply-thread)
model Thread {
  id             String   @id @default(cuid())
  conversationId String
  parentMessageId String
  createdAt      DateTime @default(now())

  messages       ThreadMessage[]

  @@index([conversationId])
  @@index([parentMessageId])
}

model ThreadMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Whisper message — ephemeral self-destructing message (Cirkle-inspired whisper-mode)
model WhisperMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  expiresAt      DateTime
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

/// Receipt split — expense splitting in chat (Cirkle-inspired receipt-split)
model ReceiptSplit {
  id             String   @id @default(cuid())
  conversationId String
  creatorId      String
  title          String
  totalAmount    Float
  currency       String   @default("SAR")
  splitCount     Int      @default(2)
  createdAt      DateTime @default(now())

  participants   ReceiptSplitParticipant[]

  @@index([conversationId])
}

model ReceiptSplitParticipant {
  id        String   @id @default(cuid())
  splitId   String
  userId    String
  amount    Float
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())

  split ReceiptSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@unique([splitId, userId])
}

/// Disappearing message settings per conversation (Cirkle-inspired privacy)
model DisappearingSetting {
  id             String   @id @default(cuid())
  conversationId String   @unique
  enabled        Boolean  @default(false)
  duration       Int      @default(86400) // seconds (86400 = 24h, 604800 = 7d, 7776000 = 90d)
  updatedAt      DateTime @updatedAt
}

/// Screenshot / capture attempt log — when a user attempts to screenshot or
/// save a protected message, the server records the attempt so the sender
/// can be notified. This is the audit trail for the screen-capture-protection
/// feature. `kind` is one of: `printscreen`, `copy`, `save`, `contextmenu`,
/// `drag`, `forward`.
model ScreenshotAttempt {
  id        String   @id @default(cuid())
  messageId String
  reporterId String? // the user who reported the attempt (the recipient, often null for server-detected)
  kind      String   @default("printscreen") // printscreen | copy | save | contextmenu | drag | forward
  note      String?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User?  @relation("ScreenshotReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([messageId, createdAt])
  @@index([reporterId])
}

// ==========================================================================
// School Connect (My School) — Cirkle-inspired verified-school identity system
//
// Three distinct concepts (per the design brief):
//   1. Institution ID   — permanent internal ID for the school (e.g. NIS-2048)
//   2. Student ID        — permanent identity assigned by the school to a
//                          student (e.g. NIS-25-08421)
//   3. Connect/Join Code — temporary, revocable credential the user enters
//                          (or scans via QR) to establish their connection
//                          to the school.
//
// Connection graph:
//   School (Institution)
//     └── SchoolStudent (Student ID + Join Code)
//           ├── User account (linked via Join Code) — the student themselves
//           └── SchoolParentConnection[] — parents/guardians connected to
//                 this student, each with their own Wasl User account.
//
// ==========================================================================

model School {
  id              String   @id @default(cuid())
  // Institution name (e.g. "Nile International School")
  name            String
  // Institution Code (e.g. "NIS-2048") — unique, permanent, public-facing
  code            String   @unique
  description     String   @default("")
  // Logo / brand color (logo can be a path or data URL)
  logoPath        String?
  logoColor       String?
  // Contact + address
  address         String?
  city            String?
  country         String?
  phone           String?
  // When true, the school's phone number is hidden from public search — only
  // connected members (students/parents/staff) see it. Mirrors the Business
  // model's hidePhone field.
  hidePhone       Boolean  @default(false)
  email           String?
  website         String?
  // Verification status
  ownerId         String   // Wasl user who registered the school (admin)
  status          String   @default("pending") // pending | verified | rejected
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      String?  // admin user id who approved
  // Type of school
  type            String   @default("international") // international | public | private | religious | university
  // Denormalized stats for fast display
  studentCount    Int      @default(0)
  staffCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner     User               @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  students  SchoolStudent[]
  members   SchoolMembership[]

  @@index([status])
  @@index([ownerId])
}

/// A student registered at a school. Each student gets a permanent Student ID
/// and a temporary Join Code (regeneratable, revocable) that they use to
/// connect their Wasl account OR that a parent scans to connect.
model SchoolStudent {
  id              String   @id @default(cuid())
  schoolId        String
  // Permanent Student ID assigned by the school — format like "NIS-25-08421"
  // (school-prefix + enrollment-year + serial). Unique within the school.
  studentId       String
  // The Wasl user account connected to this student. NULL until the student
  // themselves joins via the Connect Code.
  userId          String?
  // Student profile (admin-managed)
  fullName        String   // student's legal name
  grade           String?  // e.g. "Grade 8"
  className       String?  // e.g. "Class B"
  enrollmentYear  Int?     // e.g. 2025 (academic year)
  // Connect/Join Code — temporary, revocable credential. Format like "7K4P-92XM".
  // Generated by the school admin or the student themselves; can be regenerated
  // (which revokes the old one) or explicitly revoked.
  joinCode        String   @unique
  joinCodeGeneratedAt DateTime?
  joinCodeExpiresAt  DateTime?  // null = no expiry
  joinCodeRevoked    Boolean  @default(false)
  // Student status (active / graduated / transferred / inactive)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school            School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?                   @relation("SchoolStudentUser", fields: [userId], references: [id], onDelete: SetNull)
  parentConnections SchoolParentConnection[]

  @@unique([schoolId, studentId])
  @@index([joinCode])
  @@index([schoolId])
  @@index([userId])
}

/// Links a parent/guardian's Wasl account to a SchoolStudent. A parent can be
/// connected to multiple students (one entry per student). Each connection has
/// a relationship type (mother/father/guardian/grandparent/sibling/etc.).
model SchoolParentConnection {
  id              String   @id @default(cuid())
  schoolStudentId String
  parentId        String   // the Wasl user who is the parent/guardian
  relationship    String   @default("parent") // parent | guardian | mother | father | grandparent | sibling | other
  // Status of the connection
  status          String   @default("pending") // pending | confirmed | revoked
  invitedBy       String?  // userId of the student who invited, or null if self-joined via Connect Code
  confirmedAt     DateTime?
  revokedAt       DateTime?
  // Audit: which Join Code was used to make this connection
  joinedViaCode   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolStudent   SchoolStudent @relation(fields: [schoolStudentId], references: [id], onDelete: Cascade)
  parent          User          @relation("SchoolParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([schoolStudentId, parentId])
  @@index([parentId])
  @@index([schoolStudentId])
}

/// School membership — links a Wasl user to a school with a specific role.
/// Roles: 'admin' (school owner + designated admins), 'teacher', 'staff',
/// 'student' (mirror of SchoolStudent.userId), 'parent' (mirror of
/// SchoolParentConnection). This denormalized view makes "is this user
/// affiliated with school X?" a single query.
model SchoolMembership {
  id              String   @id @default(cuid())
  schoolId        String
  userId          String
  role            String   @default("member") // admin | teacher | staff | student | parent
  // For student role, link to SchoolStudent (optional)
  studentId       String?
  joinedAt        DateTime @default(now())
  invitedBy       String?
  status          String   @default("active") // active | revoked
  createdAt       DateTime @default(now())

  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User     @relation("SchoolMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
}

// ==========================================================================
// Block — user-to-user blocking
//
// A blocks B → B can't send messages to A, can't see A's online/last-seen,
// can't add A to new groups. A can unblock at any time.
//
// Symmetric privacy: when A blocks B, B's messages to A are silently dropped
// (B sees their own message as "sent" but it never reaches A — we don't reveal
// to B that they've been blocked, to prevent retaliation).
//
// Blocking does NOT delete the existing conversation history — it just stops
// new messages from flowing.
// ==========================================================================

model Block {
  id          String   @id @default(cuid())
  // The user who initiated the block (the blocker)
  blockerId   String
  // The user who is blocked
  blockedId   String
  // Optional reason for the block (for the blocker's own record; never shown
  // to the blocked user)
  reason       String?
  createdAt   DateTime @default(now())

  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ============================================================================
// Task 89 — API Token System + Multi-recipient Multi-message Scheduler
// ============================================================================

/// Personal access token for integrating Wasl with external platforms
/// (CRM, school admin, business automation, custom dashboards, etc.).
/// The raw token is shown ONCE at creation time; we store only the
/// SHA-256 hash so a database leak cannot compromise active tokens.
///
/// Scopes (stored as a JSON-encoded array string):
///   "business"  — access to conversations where the user sends "as a business"
///   "school"    — access to School Connect conversations (parent/admin/teacher)
///   "work"      — access to conversations the user has filed under "Work" folders
///   "personal"  — access to 1-on-1 personal chats
///
/// Plus optional permission scopes:
///   "read"      — can GET data (conversations, messages, contacts)
///   "write"     — can POST messages
///   "schedule"  — can schedule messages / batches
///
/// The token format is:  wasl_<43 base64url chars>  (48 chars total)
/// The first 8 chars after the prefix are kept as `prefix` for display
/// identification (e.g. "wasl_abc123…") without compromising the hash.
model ApiToken {
  id            String   @id @default(cuid())
  userId        String
  // User-friendly label, e.g. "HubSpot CRM sync" or "School admin bot"
  name          String
  // SHA-256 hex hash of the raw token (64 chars). Looked up on every API call.
  tokenHash     String   @unique
  // First 8 chars after "wasl_" prefix — for safe display + identification.
  prefix        String
  // JSON-encoded array of scopes, e.g. ["business","write","schedule"]
  scopes        String   @default("[]")
  // Rate limit per minute (default 60). Exceeded → 429 response.
  rateLimitPerMin Int    @default(60)
  // Soft expiration (null = never expires)
  expiresAt     DateTime?
  // Tracking — last time the token was used + from where
  lastUsedAt    DateTime?
  lastUsedIp    String?
  lastUserAgent String?
  // Soft-delete: revoked tokens are kept for audit history but rejected on use.
  revokedAt     DateTime?
  // Per-token call counter (lifetime). Useful for usage stats + alerting.
  totalCalls    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]

  @@index([userId])
  @@index([prefix])
}

/// Per-call audit log entry. One row per API request authenticated with a
/// token. Used for security forensics, anomaly detection, and per-token
/// usage dashboards. Kept 90 days (cleanup is handled by a separate job).
model AuditLog {
  id            String   @id @default(cuid())
  tokenId       String
  userId        String
  endpoint      String   // e.g. "POST /api/v1/send"
  method        String   // GET / POST / PATCH / DELETE
  ip            String?
  userAgent     String?
  statusCode    Int      // 200 / 401 / 403 / 429 / 500
  durationMs    Int      @default(0)
  // Brief context, e.g. "conversationId=xxx" or "batchId=yyy"
  context       String?
  createdAt     DateTime @default(now())

  token         ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([userId])
  @@index([createdAt])
}

/// Scheduled batch — a fan-out schedule that sends N messages to M recipients
/// at a chosen day/time. Recipients can be:
///   • specific conversations (recipientType = "conversation")
///   • all conversations of a scope (recipientType = "business" / "school" /
///     "work" / "personal")
///   • all conversations in a user-defined folder (recipientType = "folder",
///     with `folderId` set)
///
/// The batch is processed by POST /api/scheduled-batches/process (cron-callable).
/// On processing, the batch iterates over messages in `order`, then recipients,
/// and sends each (message × recipient) pair via the existing message-send
/// infrastructure (creating real Message rows + emitting socket events).
model ScheduledBatch {
  id            String   @id @default(cuid())
  userId        String
  // Optional friendly name (e.g. "Black Friday promo blast")
  name          String?
  scheduledFor  DateTime
  // 'none' | 'daily' | 'weekly' | 'monthly' — same recurrence semantics as
  // the existing ScheduledMessage model. When non-'none', the scheduler
  // advances scheduledFor to the next occurrence after processing.
  repeat        String   @default("none")
  repeatUntil   DateTime?
  // 'pending' (waiting) | 'processing' (currently sending) | 'completed' (all sent)
  // | 'partial' (some failed) | 'failed' (all failed) | 'cancelled'
  status        String   @default("pending")
  // Progress tracking while processing (e.g. "5/15 sent")
  progress      String?
  // Processing bookkeeping
  processedAt   DateTime?
  totalSent     Int      @default(0)
  totalFailed   Int      @default(0)
  // Optional: when the batch was created via an API token, store the token id
  // for audit trail.
  createdByTokenId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ScheduledBatchMessage[]
  recipients    ScheduledBatchRecipient[]

  @@index([userId])
  @@index([scheduledFor, status])
}

/// A single message in a scheduled batch. Order is determined by `order`
/// (0, 1, 2, …). `delaySeconds` is the delay applied AFTER the previous
/// message in the batch is sent — used to space out a multi-message drip.
model ScheduledBatchMessage {
  id            String   @id @default(cuid())
  batchId       String
  order         Int      @default(0)
  // Seconds to wait AFTER the previous message in the batch (default 0 —
  // send immediately after the previous). Useful for drip sequences like
  // "send intro, wait 60s, send follow-up, wait 5min, send CTA".
  delaySeconds  Int      @default(0)
  content       String
  type          String   @default("text")  // text | image
  attachmentUrl  String?
  batch         ScheduledBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([order])
}

/// A single recipient target in a scheduled batch. One row per target.
///   recipientType = "conversation" → `conversationId` is set
///   recipientType = "business" | "school" | "work" | "personal" → `scope` is set
///   recipientType = "folder" → `folderId` is set (folder scoped to user)
model ScheduledBatchRecipient {
  id             String   @id @default(cuid())
  batchId        String
  // "conversation" | "business" | "school" | "work" | "personal" | "folder"
  recipientType  String   @default("conversation")
  conversationId String?
  // When recipientType = "business" | "school" | "work" | "personal"
  scope          String?
  // When recipientType = "folder" — folder id
  folderId       String?
  batch          ScheduledBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([recipientType])
}

// ============================================================================
// Task 90 — Wasl Vault + Hash-chain integrity + Relationship Graph
// ============================================================================

/// Zero-knowledge encrypted personal vault entry. The user stores secrets
/// (passwords, recovery codes, ID numbers, secure notes) here. Everything
/// is encrypted CLIENT-SIDE with a master password using Web Crypto API
/// (PBKDF2 key derivation + AES-GCM encryption). The server only ever
/// sees the encrypted ciphertext — it cannot decrypt the contents.
///
/// The encryption format:
///   iv (12 bytes, base64) || ciphertext+authTag (base64)
/// The auth tag is appended by AES-GCM (last 16 bytes of ciphertext).
///
/// Self-destruct: when `expiresAt` is set and reached, a scheduled job
/// deletes the row AND the key derivation for that entry's master is no
/// longer useful (the entry's ciphertext is unrecoverable). Effectively a
/// cryptographically-erased secret.
model VaultEntry {
  id            String   @id @default(cuid())
  userId        String
  // "password" | "note" | "id-document" | "recovery-code" | "card" | "custom"
  type          String   @default("note")
  // The title is also encrypted (so the server can't see even the topic).
  titleCipher   String
  // The actual secret content, encrypted.
  contentCipher String
  // Optional category for sorting — also encrypted.
  categoryCipher String?
  // Optional tags (JSON array, encrypted).
  tagsCipher    String?
  // Self-destruct timestamp (null = no expiry).
  expiresAt     DateTime?
  // Tracking (server-side, not encrypted — just metadata)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accessedAt    DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Hash-chain entry — one row per message per user. Each user has their
/// own chain, so user A's view of message M has a different chainHash than
/// user B's view of the same message M.
///
/// The chainHash is computed as:
///   SHA-256(prevChainHash || messageId || conversationId || senderId || content || createdAt)
///
/// This is a hash-of-data + hash-of-prev structure (like a blockchain).
/// To verify, walk the chain in createdAt order and recompute each hash
/// from the previous one + the message data. If any hash doesn't match
/// the stored value, the chain is broken at that point.
///
/// The chain is read-only (we never edit existing entries). When a message
/// is edited, a new chain entry is appended that includes the previous
/// chainHash + the new content. This way the chain remains verifiable and
/// also serves as an immutable audit log of edits.
model MessageChainEntry {
  id            String   @id @default(cuid())
  // The message this entry corresponds to. (A message may have multiple
  // entries if it was edited — each edit appends a new chain entry.)
  messageId     String
  userId        String
  // SHA-256 hex (64 chars). Computed from prevChainHash + message data.
  chainHash     String
  // The previous entry's chainHash (null for the very first entry in a chain).
  prevChainHash String?
  // Snapshot of the message fields at this chain entry (for verification).
  // We snapshot content + senderId + conversationId so we can detect
  // tampering even if the message is later edited via a different path.
  contentHash   String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([messageId])
}

// ============================================================================
// Task 93 — Multi-device sync (PWA + cross-device session tracking)
// ============================================================================

/// A device session represents one browser tab / PWA install / native app
/// instance that the user is signed in on. The same user can have many
/// active device sessions (e.g. phone PWA + desktop browser + tablet).
///
/// When a device connects (via the chat-service socket), it registers /
/// updates its DeviceSession row. When the socket disconnects, we update
/// `lastSeenAt` + clear `socketId` (the row remains for history).
///
/// This powers:
///   - The "Devices" dialog in settings (list + revoke)
///   - The "New device signed in" toast notification
///   - Real-time multi-device sync (messages sent on phone appear on web)
model DeviceSession {
  id            String   @id @default(cuid())
  userId        String
  // Stable client-side identifier (generated once per browser/app install,
  // stored in localStorage). Survives across sessions.
  deviceId      String
  // Live socket.id (null when offline). Used by the chat-service to route
  // real-time events to this specific device.
  socketId      String?
  // Parsed human-friendly device name (e.g. "iPhone Safari", "Android Chrome",
  // "Desktop Firefox", "Wasl PWA on Android").
  deviceName    String
  // Raw user-agent for debugging
  userAgent     String?
  // Last seen IP (for security audit — null if not available)
  ip            String?
  // Whether this device is currently connected
  online        Boolean  @default(false)
  lastSeenAt    DateTime @default(now())
  // Tracking
  createdAt     DateTime @default(now())
  // For PWA installs specifically — was this registered via beforeinstallprompt?
  isPWA         Boolean  @default(false)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([socketId])
  @@index([online])
}
