# Database — Turso (libSQL) for production, local SQLite for dev
USE_TURSO=false
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Local SQLite fallback
DATABASE_URL=file:./db/custom.db

# AI Providers (at least one required for AI features)
# Primary: Groq (fast, free Llama 3.3 70B) — https://console.groq.com
GROQ_API_KEY=

# Fallback 1: OpenRouter (free models) — https://openrouter.ai
OPENROUTER_API_KEY=

# Fallback 2: Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# Fallback 3: NVIDIA — https://build.nvidia.com
NVIDIA_API_KEY=

# Hugging Face (reserved for image/vision features)
HUGGINGFACE_API_KEY=

# Push notifications (VAPID keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email (Brevo — 300 free/day)
BREVO_API_KEY=
BREVO_FROM_EMAIL=wasl@cirkle.app

# Sentry (free tier)
SENTRY_DSN=

# CORS for Socket.io
ALLOWED_ORIGINS=http://localhost:3000
