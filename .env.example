# ═══════════════════════════════════════════════════════════════
# WASL — Environment Variables Example (NO SECRETS — safe to commit)
# Copy to .env and fill in your values. All services have free tiers.
# ═══════════════════════════════════════════════════════════════

# ── PRIMARY DATABASE: Turso (libSQL) — free tier (9GB, 500 DBs) ──
# https://turso.tech → create a database, get URL + token
DATABASE_URL=file:./db/custom.db
USE_TURSO=false
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token-here

# ── FALLBACK DATABASE: Neon Postgres — free tier (3GB) ─────────
# https://neon.tech → create a project, get connection string
NEON_DATABASE_URL=
NEON_DATA_API=

# ── AI PROVIDERS (all free tiers) ──────────────────────────────
# Primary: NVIDIA DeepSeek — https://build.nvidia.com
NVIDIA_API_KEY=
# Fallback 1: Groq — https://console.groq.com
GROQ_API_KEY=
# Fallback 2: OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=
# Fallback 3: Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=
# Hugging Face (reserved for image/vision features)
HUGGINGFACE_API_KEY=

# ── EMAIL: Resend — free tier (3000 emails/mo) ────────────────
# https://resend.com → get API key
RESEND_API_KEY=

# ── BACKGROUND JOBS: Inngest — free tier ───────────────────────
# https://inngest.com → get signing key
INNGEST_EVENT_KEY=

# ── HOSTING: Vercel — free Hobby tier ─────────────────────────
VERCEL_DOMAIN=

# ── PUSH NOTIFICATIONS: VAPID keys (free, browser-native) ─────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── ERROR MONITORING: Sentry — free tier (5K errors/mo) ────────
# https://sentry.io → get DSN
SENTRY_DSN=

# ── CORS for Socket.io ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT (Vercel dashboard → Settings → Env Vars):
# Set USE_TURSO=true to switch from local SQLite to Turso.
# All other keys remain the same as above.
# NO BILLING DETAILS NEEDED — all services have free tiers.
# ═══════════════════════════════════════════════════════════════
