# Database — Turso (libSQL) for production, local SQLite for dev
USE_TURSO=false
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Local SQLite fallback
DATABASE_URL=file:./db/custom.db

# AI Providers (at least one required for AI features)
# Primary: NVIDIA DeepSeek (works from this server)
NVIDIA_API_KEY=

# Fallback 1: Groq — https://console.groq.com
GROQ_API_KEY=

# Fallback 2: OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=

# Fallback 3: Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# Hugging Face (reserved for image/vision features)
HUGGINGFACE_API_KEY=

# Push notifications (VAPID keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email service — Resend (https://resend.com)
RESEND_API_KEY=

# Background jobs — Inngest (https://inngest.com)
INNGEST_EVENT_KEY=

# Alternative database — Neon Postgres (optional)
NEON_DATABASE_URL=

# Sentry (free tier)
SENTRY_DSN=

# CORS for Socket.io
ALLOWED_ORIGINS=http://localhost:3000
